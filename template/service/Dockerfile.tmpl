# Многостадийная сборка. В контейнере нет соседнего ../parker: parker
# подтягивается по тегу (replace снят), см. go.mod / go.sum.
FROM golang:1.26-alpine AS build

ARG GOPROXY
ENV GOPROXY=${GOPROXY:-https://proxy.golang.org,direct}

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/{{.ServiceName}} ./cmd/{{.ServiceName}}

FROM alpine:3.23

RUN apk add --no-cache ca-certificates wget \
    && addgroup -S {{.ServiceName}} \
    && adduser -S {{.ServiceName}} -G {{.ServiceName}}
WORKDIR /app
COPY --from=build /out/{{.ServiceName}} /usr/local/bin/{{.ServiceName}}
COPY migrations /app/migrations
USER {{.ServiceName}}
EXPOSE 8080
ENTRYPOINT ["{{.ServiceName}}"]

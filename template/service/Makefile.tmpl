LOCAL_BIN := $(CURDIR)/bin
GOLANGCI_LINT := $(LOCAL_BIN)/golangci-lint

# Автоматически подхватываем локальный .env, если есть.
ifneq (,$(wildcard .env))
include .env
export
endif

.PHONY: dev run build test lint tidy migrate-up migrate-down

# dev — главный локальный таргет: миграции + запуск сервиса.
dev: migrate-up run

# run — запускает HTTP API {{.ServiceName}}.
run:
	go run ./cmd/{{.ServiceName}}

# build — проверяет, что весь проект компилируется.
build:
	go build ./...

# test — юнит-тесты с детектором гонок (без внешних зависимостей).
test:
	go test -race ./...

# lint — статический анализ.
lint: $(GOLANGCI_LINT)
	$(GOLANGCI_LINT) run

# migrate-up / migrate-down — применяют/откатывают миграции через parker.
migrate-up:
	go run ./cmd/{{.ServiceName}} migrate --dir migrations up

migrate-down:
	go run ./cmd/{{.ServiceName}} migrate --dir migrations down

# tidy — приводит go.mod/go.sum в соответствие с импортами.
tidy:
	go mod tidy

$(GOLANGCI_LINT):
	GOBIN="$(LOCAL_BIN)" go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.11.4
